# Copy this file to `.env` and fill in real values for local development.
# No real secrets are stored in this file.

# --- App ---
APP_NAME=savvyarchitect-backend
APP_ENV=development
DEBUG=true

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Auth secrets ---
# Both are REQUIRED in production (APP_ENV outside development/dev/local/test)
# -- get_settings() fails startup rather than run on the public dev default.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev_only_insecure_secret_do_not_use_in_production
# Independent secret for hashing client IPs in the fraud/abuse layer. Kept
# separate from JWT_SECRET so rotating one doesn't affect the other.
FRAUD_HASH_SECRET=dev_only_fraud_hash_secret_change_in_production

# --- Database (PostgreSQL via asyncpg) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/savvyarchitect

# --- Redis (Celery result backend / cache) ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ (Celery broker) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# --- Razorpay (online payment) ---
# Get a TEST key pair at https://dashboard.razorpay.com -> Settings -> API Keys.
# RAZORPAY_KEY_ID is safe to expose; RAZORPAY_KEY_SECRET must stay server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — set when you register the webhook URL in the Razorpay
# dashboard (Settings -> Webhooks). Used to verify X-Razorpay-Signature.
# RAZORPAY_WEBHOOK_SECRET=
