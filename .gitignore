# Node / Next.js
frontend/node_modules/
frontend/.next/
# Any .next/, not just the frontend's. Running `next build` from the wrong
# directory drops a full build tree wherever it was invoked, and the anchored
# rule above does not catch it.
**/.next/
frontend/out/
frontend/.env*.local

# Python / FastAPI
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/*.egg-info/
backend/.pytest_cache/
backend/.coverage
backend/media_uploads/

# Env
.env
*.env
!.env.example

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Docker/Podman volumes
pgdata/

# Runtime log dumps (podman compose logs redirected here during dev)
logs/

# graphify: derived knowledge-graph output. Rebuildable with `/graphify --update`,
# and embeds absolute paths from whoever generated it.
graphify-out/

# Python bytecode from tools/
__pycache__/
*.pyc

# Local SQLite dev database (backend/scripts/dev_bootstrap.py). Never committed.
backend/*.db
backend/*.db-journal
